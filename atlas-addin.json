{
  "schemaVersion": 1,
  "connectorApi": 1,
  "id": "unifi-connector",
  "name": "UniFi connector",
  "description": "Read-only devices, switch ports, networks, known clients and WLAN associations, based on UniFi Network+.",
  "version": "0.1.2",
  "runtime": "python",
  "entrypoint": "connector.py",
  "credentialRequired": true,
  "configuration": [
