      "key": "upstreamUrl",
      "label": "UniFi HTTPS controller URL",
      "type": "url",
      "required": true
    },
    {
      "key": "site",
      "label": "Site slug",
      "type": "text",
      "default": "default"
    },
    {
      "key": "controllerType",
      "label": "Controller type: os or classic",
      "type": "text",
      "default": "os"
    },
    {
      "key": "tlsFingerprint",
      "label": "Trusted certificate SHA-256 fingerprint (optional)",
      "type": "text"
    }
  ],
